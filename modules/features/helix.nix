{ inputs, ... }: {
  perSystem =
    { pkgs, ... }:
    {
      packages.helix = inputs.wrapper-modules.wrappers.helix.wrap {
        inherit pkgs;

        # Same LSP/formatter set neovim gets (see neovim/neovim.nix runtimePkgs).
        runtimePkgs = with pkgs; [
          nerd-fonts.jetbrains-mono

          # LSP servers
          typescript-language-server
          vscode-langservers-extracted # html, css, json
          svelte-language-server
          clang-tools # clangd
          tinymist # typst
          bash-language-server # sh
          nil # nix
          simple-completion-language-server # snippets (scls)

          # Formatters
          stylua
          prettier
          typstyle
          nixfmt
        ];

        settings = {
          # Dynamic theme generated by Noctalia shell (user template).
          theme = "noctalia";

          editor = {
            line-number = "relative";
            rulers = [ 80 ];
            bufferline = "multiple";
            color-modes = true;
            cursorline = true;
            true-color = true;
            indent-guides.render = true;
            lsp.display-inlay-hints = true;
            soft-wrap.enable = true;
            cursor-shape = {
              insert = "bar";
              normal = "block";
              select = "underline";
            };
          };

          keys = {
            normal = {
              space = {
                x = ":buffer-close";
                X = ":buffer-close!";
              };
            };
          };
        };

        languages.language-server.scls = {
          command = "simple-completion-language-server";
          config = {
            feature_snippets = true;
            feature_words = false;
            feature_paths = false;
            snippets_first = true;
          };
        };

        languages.language = [
          {
            name = "nix";
            auto-format = true;
            formatter.command = "nixfmt";
            language-servers = [
              "nil"
              "scls"
            ];
          }
          {
            name = "typst";
            auto-format = true;
            formatter.command = "typstyle";
            language-servers = [
              "tinymist"
              "scls"
            ];
          }
          {
            name = "c";
            auto-format = true;
            language-servers = [
              "clangd"
              "scls"
            ];
          }
          {
            name = "cpp";
            auto-format = true;
            language-servers = [
              "clangd"
              "scls"
            ];
          }
          {
            name = "markdown";
            language-servers = [
              "marksman"
              "markdown-oxide"
              "scls"
            ];
          }
        ];

        # Allow Helix to inherit real XDG_CONFIG_HOME so it discovers
        # runtime themes from ~/.config/helix/themes/.
        env.XDG_CONFIG_HOME = pkgs.lib.mkForce null;

        # Reuse neovim's VSCode-format snippets; filename = language id.
        # package.json is the nvim manifest, not a snippet file.
        env.SNIPPETS_PATH = "${pkgs.lib.fileset.toSource {
          root = ./snippets;
          fileset = pkgs.lib.fileset.unions [
            ./snippets/c.json
            ./snippets/cpp.json
            ./snippets/typst.json
            ./snippets/markdown.json
          ];
        }}";
        addFlag = [
          "-c"
          "${placeholder "out"}/hx-config/helix/config.toml"
        ];

        # Symlink nix-generated languages.toml into user config directory on launch
        runShell = [
          ''
            _hx_dir="''${XDG_CONFIG_HOME:-$HOME/.config}/helix"
            mkdir -p "$_hx_dir"
            ln -sf "${placeholder "out"}/hx-config/helix/languages.toml" "$_hx_dir/languages.toml"
          ''
        ];
      };
    };
}
