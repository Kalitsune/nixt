{ inputs, ... }: {
  perSystem =
    { pkgs, ... }:
    {
      packages.helix = inputs.wrapper-modules.wrappers.helix.wrap {
        inherit pkgs;

        # Same LSP/formatter set neovim gets (see neovim/neovim.nix runtimePkgs).
        runtimePkgs = with pkgs; [
          nerd-fonts.jetbrains-mono

          # LSP servers
          lua-language-server
          typescript-language-server
          vscode-langservers-extracted # html, css, json
          tailwindcss-language-server
          svelte-language-server
          clang-tools # clangd
          jdt-language-server
          tinymist # typst
          bash-language-server
          nil # nix

          # Formatters
          stylua
          prettier
          typstyle
          nixfmt
        ];

        settings = {
          # Dynamic theme generated by Noctalia shell (user template).
          theme = "noctalia";

          editor = {
            line-number = "absolute"; # mirrors options.lua number/norelativenumber
            rulers = [ 80 ]; # mirrors options.lua colorcolumn
            bufferline = "multiple";
            color-modes = true;
            cursorline = true;
            true-color = true;
            indent-guides.render = true;
            lsp.display-inlay-hints = true;
            soft-wrap.enable = true;
            cursor-shape = {
              insert = "bar";
              normal = "block";
              select = "underline";
            };
          };
        };

        languages.language = [
          {
            name = "nix";
            auto-format = true;
            formatter.command = "nixfmt";
          }
          {
            name = "typst";
            auto-format = true;
            formatter.command = "typstyle";
          }
        ];

        # Allow Helix to inherit real XDG_CONFIG_HOME so it discovers
        # runtime themes from ~/.config/helix/themes/.
        env.XDG_CONFIG_HOME = pkgs.lib.mkForce null;
        addFlag = [
          "-c"
          "${placeholder "out"}/hx-config/helix/config.toml"
        ];

        # Symlink nix-generated languages.toml into user config directory on launch
        runShell = [
          ''
            _hx_dir="''${XDG_CONFIG_HOME:-$HOME/.config}/helix"
            mkdir -p "$_hx_dir"
            ln -sf "${placeholder "out"}/hx-config/helix/languages.toml" "$_hx_dir/languages.toml"
          ''
        ];
      };
    };
}
